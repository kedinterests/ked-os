# KED Google Search Console + Analytics connector credentials.
# Copy to .env (gitignored). One Desktop-type OAuth client owned by
# chris@kedinterests.com; get_token.py fills in the refresh token.

GSC_CLIENT_ID=from_google_cloud_oauth_client
GSC_CLIENT_SECRET=from_google_cloud_oauth_client

# The Google Cloud project id that owns the OAuth client (used as the quota
# project by the Analytics connector). Looks like ked-connectors-123456.
GOOGLE_PROJECT_ID=from_google_cloud_console

# Written by get_token.py. Do not fill by hand.
GSC_REFRESH_TOKEN=
